{
  "name": "konseycomics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "titles:backfill": "node scripts/backfill-unvanlar.cjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "postbuild:vinext": "node scripts/check-cloudflare-prerender.mjs && node scripts/prepare-cloudflare-static-index.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.25.0",
    "next": "16.2.0",
    "page-flip": "^2.0.7",
    "react": "latest",
    "react-dom": "latest",
    "react-zoom-pan-pinch": "^4.2.0",
    "sharp": "^0.34.5",
    "vinext": "latest",
    "react-server-dom-webpack": "latest",
    "@vinext/cloudflare": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "wrangler": "^4.123.0",
    "vite": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "@cloudflare/vite-plugin": "1"
  },
  "type": "module"
}
