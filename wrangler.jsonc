{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "konseycomics-free-preview",
  "account_id": "8494c13b77031af3f835c47c1fca6611",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "cloudflare/free-preview/entry.js",
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 10 },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  }
}
